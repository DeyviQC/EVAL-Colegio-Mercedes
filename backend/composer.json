{
    "name": "eval/academic-foundation",
    "description": "EVAL isolated U1 prerequisite harness",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "~8.4.0",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-pdo_mysql": "*",
        "illuminate/auth": "13.35.0",
        "illuminate/cache": "13.35.0",
        "illuminate/cookie": "13.35.0",
        "illuminate/database": "^13.0",
        "illuminate/encryption": "13.35.0",
        "illuminate/events": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/hashing": "13.35.0",
        "illuminate/http": "13.35.0",
        "illuminate/session": "13.35.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": { "App\\": "app/" }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "config": {
        "allow-plugins": false,
        "secure-http": true,
        "sort-packages": true
    }
}
